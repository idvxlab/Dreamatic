PORT=4310
DREAMATIC_WORKSPACE=./workspace

# Pi uses its own configured model providers and credentials. These variables
# configure Dreamatic's media generation extensions.
DREAMATIC_IMAGE_API_KEY=
DREAMATIC_IMAGE_BASE_URL=https://api.openai.com/v1
DREAMATIC_IMAGE_RESPONSE_FORMAT=url
DREAMATIC_IMAGE_MODEL=gpt-image-1
DREAMATIC_IMAGE_DEFAULT_SIZE=1536x1024
