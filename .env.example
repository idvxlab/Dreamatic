# Local server and shared Web/CLI workspace
PORT=4310
DREAMATIC_WORKSPACE=./workspace

# Text + vision model (OpenAI-compatible)
DREAMATIC_API_KEY=
DREAMATIC_BASE_URL=https://api.openai.com/v1
DREAMATIC_MODEL=
DREAMATIC_PROVIDER_TYPE=openai-compatible
DREAMATIC_PROVIDER_NAME=Dreamatic profile

# Optional web-search provider. When omitted, Dreamatic uses DuckDuckGo.
# Serper keeps the same websearch tool contract and returns Google results.
DREAMATIC_SEARCH_PROVIDER=
DREAMATIC_SEARCH_API_KEY=

# Image generation + editing. The image key falls back to DREAMATIC_API_KEY.
DREAMATIC_IMAGE_API_KEY=
DREAMATIC_IMAGE_BASE_URL=https://api.openai.com/v1
DREAMATIC_IMAGE_MODEL=gpt-image-1
# Leave endpoints empty for the standard paths under DREAMATIC_IMAGE_BASE_URL.
DREAMATIC_IMAGE_GENERATION_ENDPOINT=
DREAMATIC_IMAGE_EDIT_ENDPOINT=
DREAMATIC_IMAGE_RESPONSE_FORMAT=b64_json
DREAMATIC_IMAGE_DEFAULT_SIZE=1536x1024

# Recovery budgets
DREAMATIC_AGENT_RETRY_ATTEMPTS=3
DREAMATIC_IMAGE_RETRY_ATTEMPTS=3
DREAMATIC_OPERATION_ATTEMPT_BUDGET=5
DREAMATIC_IMAGE_TIMEOUT_MS=300000

# Bounded visual observations sent to the model
DREAMATIC_VISUAL_PREVIEW_MAX_EDGE=1400
DREAMATIC_VISUAL_PREVIEW_MAX_BYTES=1200000
