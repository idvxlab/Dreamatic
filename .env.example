# Active Dreamatic configuration. Existing retired keys in .env are preserved but not exposed in Settings.
# Local server and shared Web/CLI workspace
PORT=4310
DREAMATIC_WORKSPACE=./workspace

# Text + vision model (OpenAI-compatible)
DREAMATIC_API_KEY=
DREAMATIC_BASE_URL=https://api.openai.com/v1
DREAMATIC_MODEL=
# Optional role-specific overrides. Omit any value to use DREAMATIC_MODEL.
DREAMATIC_MODEL_ORCHESTRATOR=
DREAMATIC_MODEL_RESEARCHER=
DREAMATIC_MODEL_DESIGNER=
DREAMATIC_MODEL_BUILDER=
DREAMATIC_THINKING_LEVEL_ORCHESTRATOR=
DREAMATIC_THINKING_LEVEL_RESEARCHER=
DREAMATIC_THINKING_LEVEL_DESIGNER=
DREAMATIC_THINKING_LEVEL_BUILDER=
DREAMATIC_PROVIDER_TYPE=openai-compatible
# Optional descriptive connection label; does not select a profile.
DREAMATIC_PROVIDER_NAME=

# Web search: blank uses DuckDuckGo.
# Serper uses DREAMATIC_SEARCH_API_KEY, falling back to legacy SERPER_API_KEY.
DREAMATIC_SEARCH_PROVIDER=
DREAMATIC_SEARCH_API_KEY=

# Image generation. The image key falls back to DREAMATIC_API_KEY.
DREAMATIC_IMAGE_API_KEY=
DREAMATIC_IMAGE_BASE_URL=https://api.openai.com/v1
DREAMATIC_IMAGE_MODEL=gpt-image-1
# Leave the endpoint empty for the standard path under DREAMATIC_IMAGE_BASE_URL.
DREAMATIC_IMAGE_GENERATION_ENDPOINT=
DREAMATIC_IMAGE_RESPONSE_FORMAT=b64_json
DREAMATIC_IMAGE_DEFAULT_SIZE=1024x1024

# Image retries and desktop behavior
# Desktop only (macOS and Windows): prevent idle system sleep during active tasks.
DREAMATIC_PREVENT_IDLE_SLEEP=true
DREAMATIC_IMAGE_RETRY_ATTEMPTS=3
# Total per-attempt request deadline, including the response body (300000 ms = 5 minutes).
DREAMATIC_IMAGE_TIMEOUT_MS=300000
# Once headers arrive, fail/retry if body data stalls; independent of a long generation deadline.
DREAMATIC_IMAGE_BODY_IDLE_TIMEOUT_MS=60000
# Independent images run concurrently (1-8). Start at 2; raise only if the provider supports it.
DREAMATIC_IMAGE_CONCURRENCY=2
# Model-only response limits; image/tool execution is excluded.
DREAMATIC_MODEL_TURN_TIMEOUT_MS=300000
DREAMATIC_MODEL_TURN_TIMEOUT_MS_RESEARCHER=180000
DREAMATIC_MODEL_IDLE_TIMEOUT_MS=120000
# Idle limit applies after the first streamed delta; first output uses the turn deadline above.

# Process-wide image-service admission control; projects rotate fairly.
DREAMATIC_IMAGE_GLOBAL_CONCURRENCY=4
# Bound buffered image response bodies (includes base64 JSON overhead).
DREAMATIC_IMAGE_RESPONSE_MAX_BYTES=67108864

# Official Gallery publication destination (Preview → Publish).
DREAMATIC_SITE_URL=https://www.dreamatic.art/

# The existing MODEL_TURN_TIMEOUT values now bound waiting for FIRST output.
# Once output starts, generation gets its own bounded allowance.
DREAMATIC_MODEL_GENERATION_TIMEOUT_MS=300000
# Optional absolute response cap; blank uses separate first-output and generation allowances.
# DREAMATIC_MODEL_TOTAL_TIMEOUT_MS=600000
# Explicitly configure only capabilities verified for your actual endpoint.
# Without verified capabilities, local thinking=off does not prove remote reasoning is disabled.
# The capability declaration is validated and saved; no model requests are sent.
# Only add supportsStrictMode:true after verifying the endpoint supports strict tools.
# DREAMATIC_MODEL_CAPABILITIES={"qwen3.7-plus":{"reasoning":true,"thinkingFormat":"qwen"}}
# Capabilities apply to exact model ids on this profile's endpoint, not all proxies.
# Supported formats, level maps and budget fields are validated in
# packages/project-data/src/provider.ts.
# thinkingLevelMap with off:null declares that off is unsupported; never label it disabled.
# DREAMATIC_MODEL_CAPABILITIES={"exact-model-id":{"reasoning":true,"thinkingFormat":"openai","supportsReasoningEffort":true,"thinkingLevelMap":{"off":null,"low":"low"}}}
