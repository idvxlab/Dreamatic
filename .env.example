# Dreamatic model and service modules
# Configure these values in Settings > Models & API, or import this file there.

# Main agent model
DREAMATIC_PROVIDER_TYPE=openai-compatible
DREAMATIC_API_KEY=
DREAMATIC_BASE_URL=https://api.example.com/v1
DREAMATIC_MODEL=gpt-5.4

# Context compression model
DREAMATIC_SUMMARY_PROVIDER_TYPE=openai-compatible
DREAMATIC_SUMMARY_API_KEY=
DREAMATIC_SUMMARY_BASE_URL=https://api.example.com/v1
DREAMATIC_SUMMARY_MODEL=gpt-4o-mini

# Image generation and editing
DREAMATIC_IMAGE_API_KEY=
DREAMATIC_IMAGE_BASE_URL=https://api.example.com/v1
DREAMATIC_IMAGE_MODEL=gpt-image-2
DREAMATIC_IMAGE_GENERATION_ENDPOINT=https://api.example.com/v1/images/generations
DREAMATIC_IMAGE_EDIT_ENDPOINT=https://api.example.com/v1/images/edits
DREAMATIC_IMAGE_BACKEND=codex
DREAMATIC_IMAGE_DEFAULT_SIZE=1024x1024

# Web search: serper or brave
DREAMATIC_SEARCH_PROVIDER=serper
DREAMATIC_SEARCH_API_KEY=

# Video generation
DREAMATIC_VIDEO_API_KEY=
DREAMATIC_VIDEO_BASE_URL=https://ark.ap-southeast.bytepluses.com
DREAMATIC_VIDEO_MODEL=seedance-1-5-pro-251215
DREAMATIC_VIDEO_ENDPOINT=https://ark.ap-southeast.bytepluses.com/api/v3/contents/generations/tasks
DREAMATIC_VIDEO_DEFAULT_RESOLUTION=720p
DREAMATIC_VIDEO_DEFAULT_DURATION=5
DREAMATIC_VIDEO_BACKEND=codex

# Hunyuan 3D generation
DREAMATIC_HUNYUAN3D_API_KEY=
DREAMATIC_HUNYUAN3D_BASE_URL=https://tokenhub.tencentmaas.com/v1/api/3d
DREAMATIC_HUNYUAN3D_MODEL=hy-3d-3.1
