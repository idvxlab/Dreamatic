{
  "name": "@dreamatic/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @dreamatic/project-data && npm run build",
    "dev": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prestart": "npm run build -w @dreamatic/project-data && npm run build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@dreamatic/project-data": "0.1.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.14",
    "playwright-core": "1.60.0",
    "sharp": "^0.35.5",
    "typebox": "1.3.27",
    "undici": "7.30.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/yazl": "^3.3.1",
    "typescript": "5.9.3"
  }
}
