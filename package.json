{
  "name": "dreamatic",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dreamatic": "apps/cli/dist/index.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build -w @dreamatic/design-agent && npm run build -w @dreamatic/server",
    "precheck": "npm run build -w @dreamatic/design-agent",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @dreamatic/design-agent && npm run build -w @dreamatic/cli && npm run build -w @dreamatic/server && npm run build -w @dreamatic/web",
    "check": "npm run check -w @dreamatic/design-agent && npm run check -w @dreamatic/cli && npm run check -w @dreamatic/server && npm run check -w @dreamatic/web",
    "start": "npm run start -w @dreamatic/server",
    "cli": "npm run start -w @dreamatic/cli --",
    "diagnose:image-edit": "node scripts/diagnose-image-edit.mjs",
    "compact-session": "node scripts/compact-visual-session.mjs",
    "diagnose:performance": "node scripts/diagnose-performance.mjs",
    "desktop:prepare": "npm run build && node scripts/desktop/prepare.mjs",
    "desktop": "npm run desktop:prepare && electron apps/desktop",
    "desktop:package": "npm run desktop:prepare && node scripts/desktop/package.mjs",
    "desktop:test": "node --test apps/desktop/test/*.test.mjs",
    "desktop:test:ui": "node apps/desktop/test-ui.mjs",
    "release:mac": "node scripts/release.mjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "typescript": "5.9.3"
  }
}
