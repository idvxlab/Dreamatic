# Image generation + editing. The image key falls back to DREAMATIC_API_KEY.
DREAMATIC_IMAGE_API_KEY=sk-8dSMzAIer8IyYKDZelLu2dJ9hFoXDpe84DafwzhUVAIX5jvP
DREAMATIC_IMAGE_BASE_URL=https://api.openai-hub.net/v1
